# Ignore everything by default
/*

# Allow Python source files and modular packages
!*.py
!*.pyw
!core/
!ui/
!utils/
!services/
!tests/
!core/**
!ui/**
!utils/**
!services/**
!tests/**

!requirements.txt
!prompt_generator.pyw

# Allow documentation
!system_overview.md
!README.md
!docs/
!docs/*.md

# Allow sysprm files
!sysprm files/
!sysprm files/*.sysprm

# Allow screenshots for README
!screenshots/
screenshots/*
!screenshots/*.png
!dashboard_desktop.png
!dashboard_mobile.png

# Allow Web Dashboard folder
!web/
!web_server.py
!shared_state.py

# Explicitly ensure sensitive settings are ignored (Safety double-check)
translator_settings.json

# Internal and translation output
__pycache__/
.checkpoints/
logs/
