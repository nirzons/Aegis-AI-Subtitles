# Ignore everything by default
/*

# Allow Python source files (root directory)
!*.py
!*.pyw

# Allow main documentation
!system_overview.md
!README.md

# Allow this gitignore file
!.gitignore
!requirements.txt

# Allow example system prompt (Un-ignore folder structure to allow file whitelist)
!sysprm files/
sysprm files/*
!sysprm files/survivor_45_hebrew.sysprm

# Allow screenshots for README
!screenshots/
screenshots/*
!screenshots/*.png

# Explicitly ensure sensitive settings are ignored (Safety double-check)
translator_settings.json

# Ignore internal directories even if they match whitelist rules
__pycache__/
.checkpoints/
logs/
sysprm files/
English subtitles/
Translated Hebrew subtitles/
